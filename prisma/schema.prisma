// データモデル。要件上のテーブルとの対応は docs/requirements.md 9.1 を参照。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  /// 月間自由予算（円）
  monthlyBudget  Int      @default(0)
  timezone       String   @default("Asia/Tokyo")
  /// 採掘の債券化率（%、0〜100、10刻み）
  bondMiningRate Int      @default(0)
  /// 毎月の収入が入る日（1〜31。その月にない日は末日）。配当・採掘・精算の「月」はこの日で区切る
  incomeDay      Int      @default(1)
  /// 収入日の変更の履歴（src/game/time.ts の IncomeEra の配列。from・prevEnd は ms、最初は null）。空なら毎月1日
  incomeEras     Json     @default("[]")
  /// 手元のお金の推測のチェックの状態（前回の設定を引き継ぐ）
  estimateChecks Json?
  createdAt      DateTime @default(now())

  sessions        Session[]
  seasons         Season[]
  purchases       Purchase[]
  savings         SavingsTransaction[]
  subscriptions   Subscription[]
  wishItems       WishItem[]
  rewardClaims    RewardClaim[]
  idempotencyKeys IdempotencyKey[]
  categories      Category[]
  currencyDefs    CurrencyDef[]
  incomes         Income[]
  adjustments     CashAdjustment[]
}

model Session {
  /// トークンの SHA-256
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SeasonStatus {
  ACTIVE
  GOAL_REACHED
  COMPLETED
}

model Season {
  id          String       @id @default(cuid())
  userId      String
  number      Int
  goalAmount  Int
  status      SeasonStatus @default(ACTIVE)
  startedAt   DateTime     @default(now())
  reachedAt   DateTime?
  completedAt DateTime?

  // 通貨（台帳 CurrencyLedger の残高）
  gold         Int @default(0)
  silver       Int @default(0)
  /// 像に積み立てた金貨（通常の交換に使えない）
  reservedGold Int @default(0)
  /// 債券（マイナス可）。急な出費の肩代わりと発展速度の倍率に使う
  bond         Int @default(0)

  // 金鉱（金額は 10^-6 G 単位）
  mineUncollected    BigInt   @default(0)
  /// 債券化した採掘の端数
  mineBondFraction   BigInt   @default(0)
  mineLastAccrualAt  DateTime
  mineMonthKey       String
  mineMinedMonth     BigInt   @default(0)
  mineSettledMonth   Int      @default(0)
  mineTotalCollected Int      @default(0)
  /// 採掘への上乗せの区間（月の収入の差分・臨時の収入。src/game/mine.ts の GoldWindow、total は文字列）
  mineWindows        Json     @default("[]")
  /// 当期の残りの採掘から減らす額（µG。月の収入の−差分）
  mineCut            BigInt   @default(0)
  /// 当期の配当で所持通貨に入った額（µG。手元のお金の推測）
  mineDividend       BigInt   @default(0)
  /// 当期のユーザ通貨の未発生分から減らす額（src/game/idle.ts の CustomCut の配列）
  customCuts         Json     @default("[]")

  /// 都市に使った金貨の累計（円）：金貨で資源・都市資金を得た額。現実で使わなかった＝貯金になったお金。
  /// 貯金額 ＝ 債券 ＋ これ（docs/record-input-redesign.md §7.1）。貯金管理の記録では戻さない
  citySpentGold    Int @default(0)
  /// 貯金額の最高到達額（技術Lvの根拠）
  maxSavingsAmount Int @default(0)

  /// 有効な記録件数（銀鉱の経験値）
  rewardedRecords Int       @default(0)
  /// 達成率の節目（25/50/75/100）で既にイベントを出したもの
  milestones      Int[]     @default([])
  /// 前回訪問時の要約（放置中の変化表示用）
  lastSeenAt      DateTime?
  lastSeenStats   Json?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          CityState?
  events        CityEvent[]
  snapshots     CitySnapshot[]
  ledger        CurrencyLedger[]
  contributions WishContribution[]
  overspends    MonthlyOverspend[]
  currencyLots  CurrencyLot[]
  accruals      CurrencyAccrual[]
  grants        ScheduledGrant[]
  resolutions   Resolution[]

  @@unique([userId, number])
  @@index([userId, status])
}

/// 街の状態（建物・資源・都市資金・発展度・技術Lv・地区・開発方針・自動建築ジョブ・最終計算時刻）
model CityState {
  seasonId  String   @id
  version   Int      @default(0)
  state     Json
  updatedAt DateTime @updatedAt
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model CityEvent {
  id        BigInt   @id @default(autoincrement())
  seasonId  String
  at        DateTime
  type      String
  auto      Boolean  @default(false)
  important Boolean  @default(false)
  payload   Json
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, at, id])
}

model CitySnapshot {
  id       String   @id @default(cuid())
  seasonId String
  kind     String // START | FINAL
  at       DateTime
  state    Json
  season   Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, kind])
}

enum Currency {
  GOLD
  SILVER
  RESERVED
  BOND
  /// ユーザ定義通貨（currencyId で区別）
  CUSTOM
}

model CurrencyLedger {
  id           BigInt   @id @default(autoincrement())
  seasonId     String
  currency     Currency
  /// CUSTOM のときの通貨
  currencyId   String?
  delta        Int
  balanceAfter Int
  reason       String
  refId        String?
  createdAt    DateTime @default(now())
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, createdAt])
}

/// その月に不足分として債券から払った額（履歴・エクスポート用）
model MonthlyOverspend {
  id       String @id @default(cuid())
  seasonId String
  monthKey String
  amount   Int
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, monthKey])
}

model Purchase {
  id              String            @id @default(cuid())
  userId          String
  /// 記録した時点のシーズン（家計履歴自体はシーズンをまたいで残る）
  seasonId        String?
  amount          Int
  date            String // YYYY-MM-DD（ユーザーのタイムゾーン）
  name            String
  /// 表示用のジャンル名（categoryId の名前を写す）
  category        String?
  categoryId      String?
  memo            String?
  /// サブスク支払いとして入力した（金鉱の精算から外す）
  isSubscription  Boolean           @default(false)
  wishItemId      String?
  /// 金鉱で精算済みの額と、その月
  settledAmount   Int               @default(0)
  settledMonth    String?
  /// 像の積立金貨から充当した額
  reservedApplied Int               @default(0)
  /// サブスクの支払い：どのサブスクの何期間分か（同じサブスク・同じ期間は1件だけ）
  subscriptionId  String?
  periodKey       String?
  /// ベース（サブスクの登録額・ほしい物の価格）。金額との差は差分として解消する
  baseAmount      Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRef     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments        PurchasePayment[]

  @@unique([subscriptionId, periodKey])
  @@index([userId, date])
}

/// 購入の支払い内訳（払い戻しを逆順に行うため）
model PurchasePayment {
  id         String   @id @default(cuid())
  purchaseId String
  /// 支払いは GOLD / BOND / CUSTOM / RESERVED、手数料は SILVER と BOND（不足分）
  currency   Currency
  /// "pay" | "fee"
  kind       String
  currencyId String?
  lotId      String?
  amount     Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

/// ジャンル（購入のカテゴリ）のマスタ
model Category {
  id         String     @id @default(cuid())
  userId     String
  name       String
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases  Purchase[]

  @@unique([userId, name])
}

enum RemainderPolicy {
  KEEP
  TO_BOND
}

/// ユーザ定義通貨。定義はシーズンをまたいで引き継ぎ、残高（ロット）はシーズンごと
model CurrencyDef {
  id            String          @id @default(cuid())
  userId        String
  name          String
  /// 絵文字1文字
  icon          String
  categoryIds   String[]
  /// 発生ルールの配列（1つ以上。形は src/game/currency.ts の Rule）
  rules         Json
  remainder     RemainderPolicy @default(KEEP)
  remainderDays Int?
  startDate     String
  endDate       String?
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  deletedAt     DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// ユーザ通貨の発生1回分（同じ日に発生したルールはまとめる）
model CurrencyLot {
  id         String    @id @default(cuid())
  seasonId   String
  currencyId String
  issuedAt   DateTime
  expiresAt  DateTime?
  amount     Int
  remaining  Int
  season     Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, currencyId, expiresAt])
}

/// ユーザ通貨の発生の進み具合（シーズン×通貨）
model CurrencyAccrual {
  seasonId      String
  currencyId    String
  lastAccrualAt DateTime
  /// 毎分ルールの端数（10^-6 単位）
  fraction      BigInt   @default(0)
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([seasonId, currencyId])
}

enum SavingsKind {
  DEPOSIT
  WITHDRAW
}

model SavingsTransaction {
  id        String      @id @default(cuid())
  userId    String
  seasonId  String?
  kind      SavingsKind
  amount    Int
  date      String
  memo      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seasonId])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Subscription {
  id        String       @id @default(cuid())
  userId    String
  name      String
  amount    Int
  cycle     BillingCycle @default(MONTHLY)
  startDate String
  endDate   String?
  memo      String?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishItem {
  id            String             @id @default(cuid())
  userId        String
  name          String
  price         Int
  priority      Int                @default(2)
  memo          String?
  purchasedAt   DateTime?
  purchaseId    String?
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions WishContribution[]

  @@index([userId])
}

model WishContribution {
  id         String   @id @default(cuid())
  seasonId   String
  wishItemId String
  /// 正で積立、負で取消・購入への充当
  amount     Int
  createdAt  DateTime @default(now())
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  wishItem   WishItem @relation(fields: [wishItemId], references: [id], onDelete: Cascade)

  @@index([seasonId, wishItemId])
}

model RewardClaim {
  id        String   @id @default(cuid())
  userId    String
  seasonId  String
  /// "purchase:<id>" / "savings:<id>"：同じ記録の報酬は1回だけ
  recordKey String   @unique
  dayKey    String
  amount    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayKey])
}

model IdempotencyKey {
  userId    String
  key       String
  status    Int
  response  Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

enum IncomeKind {
  MONTHLY
  EXTRA
}

/// 収入の記録。月の収入（収入期間ごとに1件。雛形との差分を振り分ける）と臨時の収入（全額を振り分ける）
model Income {
  id           String     @id @default(cuid())
  userId       String
  seasonId     String?
  kind         IncomeKind
  /// 月の収入の収入期間（"YYYY-MM"）
  monthKey     String?
  date         String
  name         String
  /// 金額（取り消すと 0）
  amount       Int
  /// 雛形の金額（月の収入）。臨時の収入は 0
  baseAmount   Int        @default(0)
  memo         String?
  autoExchange Boolean    @default(false)
  /// 振り分けの行（src/server/incomes.ts の AllocationRow の配列）
  allocation   Json       @default("[]")
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthKey])
  @@index([userId, date])
}

/// 予約した振り分けの1回分。放置計算で期日が来たら入れる
model ScheduledGrant {
  id         String    @id @default(cuid())
  seasonId   String
  incomeId   String
  at         DateTime
  /// GOLD / BOND / CUSTOM
  currency   Currency
  currencyId String?
  amount     Int
  /// 月の収入の配当か
  dividend   Boolean   @default(false)
  grantedAt  DateTime?
  /// 収入の減額・取り消しで取りやめた
  canceled   Boolean   @default(false)
  season     Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, grantedAt, at])
  @@index([incomeId])
}

/// 差分の解消1回分（＋差分：債券 → おまかせ交換、−差分：債券＋手数料）
model Resolution {
  id        String   @id @default(cuid())
  seasonId  String
  /// income / purchase / adjustment
  refType   String
  refId     String
  /// 正：＋差分、負：−差分
  amount    Int
  /// 債券の増減（＋差分は入った額、−差分は減らした額を負で）
  bond      Int      @default(0)
  /// 債券に入った分のうち資源をつけた額
  resourced Int      @default(0)
  /// おまかせ交換した金貨
  exchanged Int      @default(0)
  /// 得た資源・都市資金
  gains     Json?
  feeSilver Int      @default(0)
  feeBond   Int      @default(0)
  /// 金額の編集のときの前後
  before    Int?
  after     Int?
  createdAt DateTime @default(now())
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([refType, refId])
  @@index([seasonId, createdAt])
}

/// 誤差調整：手元のお金の推測と実際の額の差を解消した記録
model CashAdjustment {
  id        String   @id @default(cuid())
  userId    String
  seasonId  String?
  date      String
  /// その時のチェックの状態と各項目の額
  checks    Json
  items     Json
  estimated Int
  actual    Int
  diff      Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
